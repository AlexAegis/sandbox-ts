{
	"name": "sandbox",
	"archetype": {
		"platform": "node",
		"language": "ts"
	},
	"keywords": [
		"managed-by-autotool"
	],
	"repository": {
		"url": "git+https://github.com/AlexAegis/sandbox-ts.git",
		"type": "git"
	},
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"lint:depcheck": "turbo run lint:depcheck_ --concurrency 16 --filter sandbox",
		"lint:depcheck_": "depcheck",
		"lint:es": "turbo run lint:es_ --concurrency 16 --filter sandbox",
		"lint:es_": "eslint --max-warnings=0 --no-error-on-unmatched-pattern .",
		"lint:es:fix": "turbo run lint:es:fix_ --concurrency 16 --filter sandbox",
		"lint:es:fix_": "eslint --fix --no-error-on-unmatched-pattern .",
		"lint:format": "turbo run lint:format_ --concurrency 16 --filter sandbox",
		"lint:format_": "prettier --cache-location .cache/prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --check .",
		"lint:md": "turbo run lint:md_ --concurrency 16 --filter sandbox",
		"lint:md_": "remark --frail --no-stdout --silently-ignore .",
		"lint:tsc": "turbo run lint:tsc_ --concurrency 16 --filter sandbox",
		"lint:tsc_": "tsc --noEmit",
		"all": "BUILD_REASON='publish' turbo run all_ --concurrency 16 --filter sandbox",
		"format": "turbo run format_ --concurrency 16 --filter sandbox",
		"format_": "prettier --cache-location .cache/prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --write ."
	},
	"dependencies": {
		"moment": "^2.30.1",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@alexaegis/eslint-config-vitest": "^0.18.1",
		"@alexaegis/ts": "^0.18.1"
	}
}
